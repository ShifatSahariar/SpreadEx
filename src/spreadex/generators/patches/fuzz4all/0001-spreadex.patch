@@ -0,0 +1,172 @@
+"""One Fuzz4All target for any system under test SpreadEx can run.
+
+SpreadEx patch, derived from the ClusGram study's ``study_targets.py`` (six per-SUT classes that
+differed only in comment syntax and harness). Nothing in upstream's algorithm is changed here:
+prompt scoring (``validate_prompt``), feedback (``update``), the prompt strategies and on-the-fly
+validation all run as upstream wrote them. This class supplies the seven methods upstream leaves
+to each target, and it differs from upstream's own targets in exactly one place, stated here so it
+can be cited as an adaptation:
+
+* ``validate_individual`` executes the candidate with SpreadEx's own runner and oracle -- the same
+  command, input mode (file or stdin), working directory, environment, timeout and
+  rejection/crash rules as the campaign itself -- and maps the verdict onto upstream's FResult:
+
+      ok                  -> SAFE       (may become the next example)
+      expected_rejection  -> FAILURE    (an invalid input; never fed back)
+      crash, divergence   -> ERROR      (upstream's "potential bug" state)
+      timeout             -> TIMED_OUT
+
+As upstream intends, validation is a selection signal only: no SUT output ever reaches a prompt.
+The SUT command, paths and environment never enter a prompt either; the model sees only the
+language name, the documentation and the optional example.
+
+Every validation is appended to ``validation_records.jsonl`` with its phase ("probe" for
+autoprompt scoring, "corpus" for the fuzzing loop), so SpreadEx can report how many SUT
+executions generation itself cost.
+"""
+
+import json
+import re
+import sys
+import tempfile
+from pathlib import Path
+
+from Fuzz4All.target.target import FResult, Target
+from Fuzz4All.util.util import comment_remover
+
+#: Comment syntax per style: how a prompt line is written, and how the model's comments are removed.
+COMMENT_STYLES = ("c", "hash", "dashdash", "rem")
+
+
+def _strip_line_comments(code: str, token: str) -> str:
+    """Remove `token` line comments outside string literals (from the ClusGram study targets)."""
+    pattern = re.compile(r"(\"(?:\\.|[^\"\\])*\"|'(?:\\.|[^'\\])*')|" + re.escape(token) + r"[^\n]*")
+    return pattern.sub(lambda m: m.group(1) or "", code)
+
+
+class SpreadExTarget(Target):
+    def __init__(self, **kwargs):
+        config_dict = kwargs["config_dict"]
+        sx = config_dict["spreadex"]
+        # Needed by wrap_in_comment, which upstream's __init__ already calls.
+        self.comment_style = sx.get("comment_style", "c")
+        if self.comment_style not in COMMENT_STYLES:
+            raise ValueError(f"comment_style must be one of {COMMENT_STYLES}, not {self.comment_style!r}")
+        super().__init__(**kwargs)
+        if kwargs.get("template") != "fuzzing_with_config_file":
+            raise NotImplementedError("SpreadEx drives Fuzz4All through a config dict only.")
+        self.config_dict = config_dict
+        self.prompt_used = self._create_prompt_from_config(config_dict)
+        self.DISPLAY_NAME = sx.get("language_name") or "program"
+        self.SYSTEM_MESSAGE = f"You are a {self.DISPLAY_NAME} Fuzzer"
+        self.extension = str(sx.get("input_extension") or "").lstrip(".")
+
+        # SpreadEx's execution plane is standard library only, so it is imported from the tool's
+        # own installation: one definition of how an input runs and what its outcome means.
+        if sx["spreadex_path"] not in sys.path:
+            sys.path.insert(0, sx["spreadex_path"])
+        from spreadex.exec.oracle import make_oracle
+        from spreadex.exec.runner import Target as SutTarget
+        from spreadex.exec.runner import run_one
+
+        self._run_one = run_one
+        self._sut_targets = [SutTarget.from_config(t) for t in sx["targets"]]
+        # This process holds the LLM credentials (the SDK reads them from the environment). A
+        # generated program must not be able to read them back, so every SUT run blanks them.
+        for t in self._sut_targets:
+            t.env.update({"OPENAI_API_KEY": "", "OPENAI_BASE_URL": ""})
+        self._oracle = make_oracle(sx.get("oracle") or {})
+        # Probe files live here, outside the corpus folder; SpreadEx removes it after the run.
+        self._scratch = Path(sx.get("scratch_dir") or tempfile.mkdtemp(prefix="spreadex-f4a-"))
+        self._scratch.mkdir(parents=True, exist_ok=True)
+
+    # -- prompt scaffolding in the target language's comment syntax -------------
+
+    def _comment_lines(self, prompt: str, prefix: str) -> str:
+        return "\n".join(f"{prefix} {line}".rstrip() for line in (prompt.splitlines() or [""]))
+
+    def wrap_in_comment(self, prompt: str) -> str:
+        style = self.comment_style
+        if style == "c":
+            return f"/* {prompt} */"
+        if style == "hash":
+            return self._comment_lines(prompt, "#")
+        if style == "dashdash":
+            return self._comment_lines(prompt, "--")
+        return self._comment_lines(prompt, "REM")
+
+    def wrap_prompt(self, prompt: str) -> str:
+        return f"{self.wrap_in_comment(prompt)}\n{self.prompt_used['separator']}\n{self.prompt_used['begin']}"
+
+    def _clean(self, code: str) -> str:
+        style = self.comment_style
+        if style == "c":
+            return comment_remover(code, lang="cpp")
+        if style == "hash":
+            return _strip_line_comments(code, "#")
+        if style == "dashdash":
+            code = re.sub(r"/\*.*?\*/", "", code, flags=re.DOTALL)
+            return _strip_line_comments(code, "--")
+        return "\n".join(l for l in code.split("\n") if not l.lstrip().upper().startswith("REM"))
+
+    # -- the methods upstream leaves to each target (as in the ClusGram targets) --
+
+    def write_back_file(self, code: str) -> str:
+        suffix = f".{self.extension}" if self.extension else ""
+        path = self._scratch / f"probe_{self.CURRENT_TIME}{suffix}"
+        try:
+            path.write_text(code, encoding="utf-8")
+        except OSError:
+            pass
+        return str(path)
+
+    def filter(self, code: str) -> bool:
+        clean_code = code.replace(self.prompt_used["begin"], "").strip()
+        return bool(clean_code) and self.prompt_used["target_api"] in clean_code
+
+    def clean(self, code: str) -> str:
+        cleaned = self._clean(code).strip()
+        return f"{cleaned}\n" if cleaned else ""
+
+    def clean_code(self, code: str) -> str:
+        code = self.clean(code)
+        return "\n".join(l for l in code.split("\n")
+                         if l.strip() != "" and l.strip() != self.prompt_used["begin"])
+
+    # -- validation through SpreadEx's runner and oracle -----------------------
+
+    VALIDATION_RECORD_FILE = "validation_records.jsonl"
+    _MAP = {"ok": FResult.SAFE, "expected_rejection": FResult.FAILURE, "crash": FResult.ERROR,
+            "divergence": FResult.ERROR, "timeout": FResult.TIMED_OUT}
+
+    def validate_individual(self, filename) -> (FResult, str):
+        path = Path(filename)
+        if self.extension and path.suffix != f".{self.extension}":
+            # Upstream names corpus files N.fuzz; many processors choose a front end by extension.
+            linked = self._scratch / f"{path.stem}.{self.extension}"
+            try:
+                linked.write_bytes(path.read_bytes())
+                run_path = linked
+            except OSError:
+                run_path = path
+        else:
+            run_path = path
+        try:
+            observations = [self._run_one(t, run_path) for t in self._sut_targets]
+            judgement = self._oracle.judge(observations)
+            verdict = judgement.verdict.value
+            result, message = self._MAP.get(verdict, FResult.FAILURE), verdict
+        except Exception as exc:  # infrastructure, not a finding: never reported as ERROR
+            verdict, result, message = "harness_error", FResult.FAILURE, type(exc).__name__
+        try:
+            inside = path.resolve().is_relative_to(Path(self.folder).resolve())
+        except (OSError, ValueError):
+            inside = False
+        row = {"file": path.name, "stem": path.stem, "verdict": verdict, "status": result.name,
+               "phase": "corpus" if inside else "probe"}
+        try:
+            with open(Path(self.folder) / self.VALIDATION_RECORD_FILE, "a", encoding="utf-8") as fh:
+                fh.write(json.dumps(row) + "\n")
+        except OSError:
+            pass
+        return result, message
