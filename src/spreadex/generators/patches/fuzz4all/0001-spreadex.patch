+# --- ClusGram study patch -------------------------------------------------
+# Chat-completions backend used in place of the local StarCoder checkpoint, so
+# this artifact runs with the same LLM as the generator it is compared against.
+#
+# It reproduces StarCoder's *semantics*, not its interface:
+#
+#   * one prompt in, `batch_size` independent completions out;
+#   * `self.max_length` is a TOTAL prompt+completion budget, exactly as in
+#     StarCoder.generate's `min(self.max_length, len(input_tokens) + max_length)`.
+#     This is what keeps the fed-back example from ratcheting program length up
+#     without bound: as the example grows, the room left to generate shrinks;
+#   * every completion is truncated at the earliest end-of-sequence marker.
+#
+# Residual, unavoidable interface deviations (recorded in the run record):
+#   1. The Fuzz4All prompt is a source file whose instructions are comments. It
+#      is delivered here as a single user message. There is no system message,
+#      no assistant turn, and no previous example converted to chat history:
+#      that would change the distribution being sampled and break the
+#      "prompt rebuilt each round" invariant.
+#   2. StarCoder's <fim_prefix>/<fim_suffix> infilling tokens have no chat
+#      equivalent and are dropped.
+#   3. The API accepts at most 4 stop sequences while the eos list is longer.
+#      Python-side truncation below always applies the *full* list, so this is
+#      a cost/latency deviation, not a semantic one.
+#
+# Retry policy is duplicated from the study's settings rather than imported, so
+# this tree stays runnable standalone against upstream.
+OPENAI_RETRY_MAX_ATTEMPTS = 4
+OPENAI_RETRY_DELAYS_SECONDS = (2, 4, 8)
+OPENAI_MAX_STOP_SEQUENCES = 4
+
+
+def _select_stop_sequences(eos: List[str], limit: int = OPENAI_MAX_STOP_SEQUENCES) -> List[str]:
+    """Pick at most `limit` stop strings, preferring the most specific.
+
+    Purely a cost optimisation: a completion that runs past a dropped stop
+    string is still truncated by `_truncate_at_eos` against the full list.
+    """
+    unique = [s for s in dict.fromkeys(e for e in eos if e)]
+    # A string that is a strict prefix of another retained one already covers it.
+    non_prefix = [s for s in unique if not any(o != s and o.startswith(s) for o in unique)]
+    return sorted(non_prefix or unique, key=len, reverse=True)[:limit]
+
+
+def _truncate_at_eos(text: str, eos: List[str]) -> str:
+    """Cut at the earliest occurrence of any eos string (StarCoder behaviour)."""
+    cut = len(text)
+    for stop in eos:
+        if stop and stop in text:
+            cut = min(cut, text.index(stop))
+    return text[:cut]
+
+
+class OpenAIChatModel:
+    def __init__(self, model_name: str, device: str, eos: List, max_length: int) -> None:
+        from openai import OpenAI
+
+        self.model_name = model_name
+        self.device = device
+        self.eos = EOF_STRINGS + list(eos)
+        self.max_length = max_length  # TOTAL prompt + completion budget
+        self.stop = _select_stop_sequences(self.eos)
+        self.dropped_stop = [s for s in self.eos if s and s not in self.stop]
+        self.usage = {"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0}
+        self.token_estimate_backend = "tiktoken"
+        # No explicit api_key/base_url: the SDK reads OPENAI_API_KEY and
+        # OPENAI_BASE_URL itself, which is also how upstream's own
+        # util/api_request.py constructs its client. One convention for both
+        # the distillation and the generation call.
+        self._client = OpenAI()
+
+    def count_tokens(self, text: str) -> int:
+        try:
+            import tiktoken
+
+            try:
+                encoding = tiktoken.encoding_for_model(self.model_name)
+            except KeyError:
+                encoding = tiktoken.get_encoding("o200k_base")
+            return len(encoding.encode(text))
+        except Exception:
+            # Over-estimating silently shrinks the completion budget and looks
+            # like the model "getting lazier" on long prompts, so say so.
+            self.token_estimate_backend = "heuristic_len_div_4"
+            return max(1, len(text) // 4)
+
+    def _request(self, **kwargs):
+        last: Exception | None = None
+        for attempt in range(OPENAI_RETRY_MAX_ATTEMPTS):
+            try:
+                return self._client.chat.completions.create(**kwargs)
+            except Exception as exc:  # transient API/network failure
+                last = exc
+                if attempt == OPENAI_RETRY_MAX_ATTEMPTS - 1:
+                    break
+                delay_index = min(attempt, len(OPENAI_RETRY_DELAYS_SECONDS) - 1)
+                time.sleep(OPENAI_RETRY_DELAYS_SECONDS[delay_index])
+        raise RuntimeError(
+            f"OpenAI request failed after {OPENAI_RETRY_MAX_ATTEMPTS} attempts: {last}"
+        ) from last
+
+    def _accumulate(self, response) -> None:
+        usage = getattr(response, "usage", None)
+        if usage is None:
+            return
+        for key in ("prompt_tokens", "completion_tokens", "total_tokens"):
+            self.usage[key] += int(getattr(usage, key, 0) or 0)
+
+    def generate(
+        self, prompt, batch_size=10, temperature=1.0, max_length=512
+    ) -> List[str]:
+        prompt_tokens = self.count_tokens(prompt)
+        # StarCoder: min(self.max_length, len(input_tokens) + max_length) is a
+        # cap on the WHOLE sequence, so the completion allowance is whatever is
+        # left of the total budget.
+        completion_budget = min(max_length, self.max_length - prompt_tokens)
+        if completion_budget <= 0:
+            print(
+                f"[OpenAIChatModel] prompt of {prompt_tokens} tokens exhausts the "
+                f"total budget of {self.max_length}; returning no candidates"
+            )
+            return []
+
+        request = {
+            "model": self.model_name,
+            "messages": [{"role": "user", "content": prompt}],
+            "temperature": max(temperature, 1e-2),
+            "max_tokens": completion_budget,
+            "top_p": 1.0,
+        }
+        if self.stop:
+            request["stop"] = self.stop
+
+        try:
+            response = self._request(n=batch_size, **request)
+            self._accumulate(response)
+            raw = [(choice.message.content or "") for choice in response.choices]
+        except Exception:
+            # Some OpenAI-compatible gateways reject `n`; fall back to
+            # independent calls so batch semantics are preserved.
+            raw = []
+            for _ in range(batch_size):
+                response = self._request(n=1, **request)
+                self._accumulate(response)
+                raw.append(response.choices[0].message.content or "")
+
+        # Chat models wrap code in markdown fences; StarCoder, a completion
+        # model, never does, so upstream's language `clean()` does not strip
+        # them and every fenced program would be invalid. Upstream hits the same
+        # problem on its own chat backend and solves it with `simple_parse`
+        # (see Target.generate_model's ollama branch, which falls back to the
+        # raw content when no fence is present). Same function, same fallback.
+        unfenced = [(simple_parse(text) or text) for text in raw]
+        outputs = [_truncate_at_eos(text, self.eos) for text in unfenced]
+        # Callers index into this list, so keep its length equal to batch_size.
+        outputs.extend([""] * (batch_size - len(outputs)))
+        return outputs[:batch_size]
+
+
+# --- end ClusGram study patch ---------------------------------------------
