+# --- ClusGram study patch -------------------------------------------------
+# Upstream retries BadRequestError forever with no backoff. A 400 is normally
+# *deterministic* -- a content-policy rejection, or a malformed request -- so
+# the same input yields the same rejection and the loop spins indefinitely,
+# reprinting the error. For an unattended study run that is worse than failing:
+# the campaign looks alive while making no progress, and autoprompting is the
+# first thing that runs, so a whole SUT can stall before a single input exists.
+#
+# Only this class is bounded. RateLimitError and APIConnectionError keep
+# upstream's unbounded retry, because those genuinely do resolve on their own
+# and capping them would abort legitimate runs.
+MAX_BAD_REQUEST_ATTEMPTS = 3
+
+# Upstream's catch-all branch is also unbounded (1s sleep, retry forever). A
+# *deterministic* unknown error therefore hangs a run rather than failing it --
+# which is exactly what happened: `signal.signal` raises ValueError off the main
+# thread (see `_alarm_supported`), the catch-all swallowed it, and the campaign
+# spun silently. Bounded higher than the 400 cap because this class does include
+# genuinely transient faults.
+MAX_UNKNOWN_ERROR_ATTEMPTS = 5
+
+
+def _alarm_supported() -> bool:
+    """Whether SIGALRM can be installed on the calling thread.
+
+    `signal.signal` only works in the main thread of the main interpreter. The
+    study runs this from a ThreadPoolExecutor worker (the orchestrator executes
+    a cell's runs concurrently), so the alarm must be skipped there. The OpenAI
+    client applies its own request timeout, so dropping the alarm loses a
+    belt-and-braces guard, not the only one.
+    """
+    return threading.current_thread() is threading.main_thread()
+
+
+def _set_alarm(seconds: int) -> None:
+    if _alarm_supported():
+        signal.signal(signal.SIGALRM, handler)
+        signal.alarm(seconds)
+
+
+def _clear_alarm() -> None:
+    if _alarm_supported():
+        signal.alarm(0)
+
+
+# Distillation (autoprompting) token usage. Upstream discards the `usage` block
+# on these responses, so there is no other way to separate the setup cost of
+# autoprompting from the per-run generation cost. Generation cost is tracked
+# independently on the model object (`OpenAIChatModel.usage`).
+USAGE = {"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0, "requests": 0}
+
+
+def reset_usage() -> None:
+    for key in USAGE:
+        USAGE[key] = 0
+
+
+def _accumulate_usage(response) -> None:
+    usage = getattr(response, "usage", None)
+    USAGE["requests"] += 1
+    if usage is None:
+        return
+    for key in ("prompt_tokens", "completion_tokens", "total_tokens"):
+        USAGE[key] += int(getattr(usage, key, 0) or 0)
+
